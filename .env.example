# Public Mapbox access token (pk.*) — https://account.mapbox.com/access-tokens/
# Copy this file to .env.local and paste your own token. .env.local is gitignored.
VITE_MAPBOX_TOKEN=

# WebSocket endpoint for the backend event feed, e.g. ws://localhost:8000/ws.
# Leave it empty and the dashboard runs on the scripted scenario feed instead,
# which is what the demo uses until the FastAPI service is up.
VITE_WS_URL=
